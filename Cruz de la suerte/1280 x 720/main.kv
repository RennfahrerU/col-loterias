        BoxLayout:
                size_hint:.9, .4
                orientation: 'horizontal'
                padding:60
                pos_hint:{'center_x':.99,'y':.825}

                Button:
                        text:"Sumar"
                        size_hint:None, None
                        width:90
                        height:80
                        on_press: root.calculo_1(), root.calculo_2(), root.calculo_3(), root.calculo_4(), root.calculo_5(), root.calculo_6(), root.calculo_7(), root.calculo_8()

                Button:
                        text:"Limpiar"
                        size_hint:None, None
                        width:90
                        height:80
                        on_press: root.limpiar (input_a.text), root.limpiar (input_b.text), root.limpiar (input_c.text), root.limpiar (input_d.text), root.limpiar (input_e.text), root.limpiar (input_f.text)  #primer botón

                Button:
                        text:"Cerrar"
                        size_hint:None, None
                        width:90
                        height:80
                        on_press: root.cerrar() #segundo botón

